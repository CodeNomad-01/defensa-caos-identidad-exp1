# Copia este archivo como .env solo si quieres cambiar los valores por defecto.
# run_identidad.py y las pruebas NO necesitan .env: el script fija sus propias variables.
ENVIRONMENT=pruebas
DATABASE_URL=sqlite:///./chaos/runtime/identidad.db
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./data/object-storage
INTEGRATION_STUB_WHEN_UNREACHABLE=true

# Token estatico del plano de control (ronda 0). Valor de laboratorio, no es un secreto real.
CHAOS_TOKEN=caos-local

# Experimento 1. En true el plano de control /internal/* exige la credencial efimera (ronda 1).
IDENTIDAD_ESTRICTA=false
# Secreto HMAC del emisor. Dejalo vacio aqui: run_identidad.py genera uno aleatorio en cada corrida.
IDENTIDAD_SECRETO=
IDENTIDAD_AUDIENCIA=clic-kiusys-control
IDENTIDAD_TTL_S=60
IDENTIDAD_ORIGENES=127.0.0.1
